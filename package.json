{
  "name": "opentile",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first pixel-art level editor with game-ready exports.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matheuseabra/opentile.git"
  },
  "bugs": {
    "url": "https://github.com/matheuseabra/opentile/issues"
  },
  "homepage": "https://github.com/matheuseabra/opentile#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:lib && npm run test:unit && npm run build",
    "test:lib": "tsx tests/lib-smoke.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.25.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "30.0.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
